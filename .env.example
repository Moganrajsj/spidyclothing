DB_HOST=srv1995.hstgr.io
DB_PORT=3306
DB_NAME=u434287574_spidymensware
DB_USER=replace-with-the-exact-database-user
DB_PASSWORD=
# Connection pool settings for serverless environments (defaults: 3 connections, 20 queue limit)
DB_CONNECTION_LIMIT=3
DB_QUEUE_LIMIT=20
API_PORT=3001
SESSION_SECRET=replace-with-a-long-random-secret
# Google OAuth 2.0 (optional). Leave blank to hide/disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin used to build OAuth redirect URLs and validate request origins.
# In local dev: http://localhost:5173
# In production on Vercel: https://spidyclothing.com
APP_ORIGIN=http://localhost:5173
# Cloudinary (optional). When unset, product image uploads fall back to local disk.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional analytics/advertising IDs. These are public build-time values, never secrets.
# Trackers stay unloaded until the visitor grants the matching consent.
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=
# Hostinger Email SMTP (for order confirmation & cancellation emails)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@spidyclothing.com
SMTP_PASS=
MAIL_FROM=orders@spidyclothing.com
MAIL_FROM_NAME=SPIDY CLOTHING
MAIL_REPLY_TO=support@spidyclothing.com
# Distributed rate limiting with Upstash Redis (optional - falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Database backup encryption (optional - 32-char passphrase or random string for AES-256-GCM)
BACKUP_ENCRYPTION_KEY=
