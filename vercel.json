{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/$1"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  }
}
