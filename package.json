{
  "name": "spidy-mens-wear",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "db:migrate": "node --env-file=.env.local server/migrate.js && node --env-file=.env.local server/admin-migrate.js && node --env-file=.env.local server/auth-migrate.js && node --env-file=.env.local server/email-migrate.js",
    "db:backup": "node --env-file=.env.local server/backup-db.js",
    "db:optimize-indexes": "node --env-file=.env.local server/optimize-indexes.js",
    "admin:setup": "node --env-file=.env.local server/setup-admin.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "gsap": "^3.15.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
